# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before running docker compose.
#   cp .env.example .env
# `.env` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# ---- Database ----
POSTGRES_DB=ams
POSTGRES_USER=ams
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# ---- API ----
API_PORT=8080

# JWT signing key for HS256. MUST be at least 32 characters.
# Generate one with:
#   openssl rand -base64 48
#   # or, on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_KEY=

# ---- Frontend ----
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# Where the Next.js *server* reaches the API. The browser never uses this — it
# calls Next's own /api/proxy route, which forwards with the bearer token.
#   docker compose: set on the `web` service to http://api:8080 (already wired)
#   `npm run dev`:  defaults to http://localhost:5140, the Kestrel dev port.
# Override here only if you run the API on a different port.
# API_BASE_URL=http://localhost:5140
